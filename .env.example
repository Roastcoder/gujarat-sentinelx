# ==============================================================================
# GUJARAT SENTINELX - CONFIGURATION ENVIRONMENT
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEMO_MODE=true
APP_NAME="Gujarat SentinelX"
API_V1_STR=/api/v1

# Security & Authentication
JWT_SECRET=cctv-sentinelx-gujarat-gov-hackathon-2026-secure-key-32b
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Primary Database (PostgreSQL + PostGIS in Docker, or SQLite for zero-dependency standalone dev)
# For Docker Postgres: postgresql+asyncpg://sentinelx:sentinelx_secret@localhost:5432/sentinelx
# For local zero-dependency: sqlite+aiosqlite:///./sentinelx.db
DATABASE_URL=sqlite+aiosqlite:///./sentinelx.db
DATABASE_SYNC_URL=sqlite:///./sentinelx.db
POSTGRES_USER=sentinelx
POSTGRES_PASSWORD=sentinelx_secret
POSTGRES_DB=sentinelx
POSTGRES_PORT=5432

# Redis Cache & Realtime PubSub
REDIS_URL=redis://localhost:6379/0

# Kafka Distributed Streaming (Optional in standalone prototype - in-memory fallback enabled)
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_DETECTIONS=cctv.detections.vehicle
KAFKA_TOPIC_ANPR=cctv.anpr.events
KAFKA_TOPIC_ALERTS=cctv.alerts.priority

# OpenSearch (Optional in standalone prototype - SQL fallback enabled)
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=admin

# ClickHouse Time-Series Analytics (Optional in standalone prototype - SQL fallback enabled)
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# MinIO / S3 Object Storage (Evidence & Snapshots - local file storage fallback enabled)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=sentinelx-evidence
STORAGE_PATH=./storage/evidence

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws
